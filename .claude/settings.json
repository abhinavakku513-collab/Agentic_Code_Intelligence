{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONHASHSEED": "0",
    "TOKENIZERS_PARALLELISM": "false",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "ACIS_ENV": "dev",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock)",
      "Bash(make *)",
      "Bash(ruff *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(scripts/run_detached.sh *)",
      "Bash(scripts/job_status.sh*)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:docs.mteb.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(make rc-official*)",
      "Bash(uv run acis eval official*)",
      "Bash(acis eval official*)",
      "Bash(uv run python -m acis.eval.final*)"
    ],
    "deny": [
      "Read(./data/sealed/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Edit(./data/**)",
      "Edit(./configs/splits.lock.json)",
      "Edit(./runs/ledger.jsonl)",
      "Edit(./docs/official/**)",
      "Bash(sudo *)",
      "Read(~/.acis-sealed/**)",
      "Edit(~/.acis-sealed/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle.py session",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle.py post",
            "timeout": 40
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle.py stop",
            "timeout": 260
          }
        ]
      }
    ]
  }
}
